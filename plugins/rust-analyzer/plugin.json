{
  "name": "rust-analyzer",
  "displayName": "Rust",
  "version": "1.0.0",
  "description": "Go to Definition, hovers, completions and problems in Rust files, with rust-analyzer",
  "enabled": false,
  "contributes": {
    "settings": {
      "path": { "type": "string", "default": "rust-analyzer", "description": "The rust-analyzer program, by name or path" }
    },
    "languageServers": [
      { "id": "rust-analyzer.server", "languages": ["rust"], "command": "${settings.path}",
        "install": "rustup component add rust-analyzer",
        "download": { "url": "https://github.com/rust-lang/rust-analyzer/releases/latest/download/rust-analyzer-{arch}-{os}.gz",
          "os": {"linux": "unknown-linux-gnu", "darwin": "apple-darwin"} } }
    ]
  }
}
