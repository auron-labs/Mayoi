{
  "name": "marksman",
  "displayName": "Markdown",
  "version": "1.0.0",
  "description": "Links, headings and references across Markdown files, with marksman",
  "enabled": false,
  "contributes": {
    "settings": {
      "path": { "type": "string", "default": "marksman", "description": "The marksman program, by name or path" }
    },
    "languageServers": [
      { "id": "marksman.server", "languages": ["markdown"], "command": "${settings.path}",
        "args": ["server"], "companion": true,
        "download": { "url": "https://github.com/artempyanykh/marksman/releases/latest/download/marksman-{os}-{arch}",
          "os": {"linux": "linux"}, "arch": {"x86_64": "x64", "aarch64": "arm64"} } }
    ]
  }
}
