{
  "name": "clojure-lsp",
  "displayName": "Clojure",
  "version": "1.0.0",
  "description": "Go to Definition, hovers, completions and problems in Clojure files, with clojure-lsp",
  "enabled": false,
  "contributes": {
    "settings": {
      "path": { "type": "string", "default": "clojure-lsp", "description": "The clojure-lsp program, by name or path" }
    },
    "languageServers": [
      { "id": "clojure-lsp.server", "languages": ["clojure"], "command": "${settings.path}",
        "download": { "url": "https://github.com/clojure-lsp/clojure-lsp/releases/latest/download/clojure-lsp-native-{os}-{arch}.zip",
          "bin": "clojure-lsp", "os": {"linux": "linux", "darwin": "macos"}, "arch": {"x86_64": "amd64", "aarch64": "aarch64"} } }
    ]
  }
}
