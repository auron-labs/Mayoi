{
  "name": "phpantom",
  "displayName": "PHP",
  "version": "1.0.0",
  "description": "Go to Definition, hovers, completions and problems in PHP files, with PHPantom",
  "enabled": false,
  "contributes": {
    "settings": {
      "path": { "type": "string", "default": "phpantom_lsp", "description": "The phpantom_lsp program, by name or path" }
    },
    "languageServers": [
      { "id": "phpantom.server", "languages": ["php"], "command": "${settings.path}",
        "install": "cargo install phpantom_lsp --locked",
        "download": { "url": "https://github.com/PHPantom-dev/phpantom_lsp/releases/latest/download/phpantom_lsp-{arch}-{os}.tar.gz", "bin": "phpantom_lsp",
          "os": {"linux": "unknown-linux-gnu", "darwin": "apple-darwin"} } }
    ]
  }
}
