{
  "name": "tinymist",
  "displayName": "Typst",
  "version": "1.0.0",
  "description": "Go to Definition, hovers, completions and problems in Typst files, with tinymist",
  "enabled": false,
  "contributes": {
    "settings": {
      "path": { "type": "string", "default": "tinymist", "description": "The tinymist program, by name or path" }
    },
    "languageServers": [
      { "id": "tinymist.server", "languages": ["typst"], "command": "${settings.path}",
        "install": "cargo install --locked tinymist",
        "download": { "url": "https://github.com/Myriad-Dreamin/tinymist/releases/latest/download/tinymist-{os}-{arch}",
          "arch": {"x86_64": "x64", "aarch64": "arm64"} } }
    ]
  }
}
