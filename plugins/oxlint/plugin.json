{
  "name": "oxlint",
  "displayName": "oxlint",
  "version": "1.0.0",
  "description": "Problems in JavaScript, TypeScript, Vue and Svelte files, with oxlint, beside TypeScript's own server",
  "enabled": false,
  "contributes": {
    "settings": {
      "path": { "type": "string", "default": "oxlint", "description": "The oxlint program, by name or path" }
    },
    "languageServers": [
      { "id": "oxlint.server", "languages": ["typescript", "javascript", "react", "vue", "svelte"],
        "command": "${settings.path}", "args": ["--lsp"], "companion": true, "install": "npm install -g oxlint" }
    ]
  }
}
