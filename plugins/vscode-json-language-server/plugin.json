{
  "name": "vscode-json-language-server",
  "displayName": "JSON",
  "version": "1.0.0",
  "description": "Hovers, completions, problems and formatting in JSON files, with vscode-json-language-server",
  "enabled": false,
  "contributes": {
    "settings": {
      "path": { "type": "string", "default": "vscode-json-language-server", "description": "The vscode-json-language-server program, by name or path" }
    },
    "languageServers": [
      { "id": "vscode-json-language-server.server", "languages": ["json"], "command": "${settings.path}", "args": ["--stdio"],
        "initializationOptions": { "provideFormatter": true }, "schemas": "json",
        "install": "npm install -g vscode-langservers-extracted" }
    ]
  }
}
